# ============================================================
# OneFounder — Vercel Environment Variables
# ============================================================
# Copy these into Vercel → Project → Settings → Environment Variables
# Required variables are marked [REQUIRED]
# ============================================================

# ── Database ─────────────────────────────────────────────────
# [REQUIRED] Neon PostgreSQL connection string
# Get from: https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Auth ─────────────────────────────────────────────────────
# [REQUIRED] Random 32+ character secret for session encryption
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here-at-least-32-chars

# [REQUIRED] Your production URL (no trailing slash)
BETTER_AUTH_URL=https://your-app.vercel.app

# Optional: Public URL shown in auth emails
CLIENT_URL=https://your-app.vercel.app

# ── Node.js Runtime ──────────────────────────────────────────
# [REQUIRED] Force Node.js 22 on Vercel
NODE_VERSION=22

# ── Ollama (Local Inference) ──────────────────────────────────
# NOTE: Ollama runs on the USER's machine, not on Vercel.
# For Vercel deployments, users must run Ollama locally and set
# OLLAMA_BASE_URL to their local Ollama instance if using a
# self-hosted server setup. For pure local development (npm run dev),
# the default localhost:11434 works automatically.

# Ollama server URL (default: http://localhost:11434)
# Only set this if you're running OneFounder as a server + users connect remotely
OLLAMA_BASE_URL=http://localhost:11434

# Default Ollama model
OLLAMA_MODEL=qwen3:8b

# ── Optional: Social Auth ────────────────────────────────────
# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── Optional: Features ──────────────────────────────────────
# Node environment (set automatically by Vercel)
# NODE_ENV=production

# ============================================================
# IMPORTANT: No AI API keys required.
# OneFounder uses Ollama (local inference) exclusively.
# Monthly AI cost: ₹0 / $0
# ============================================================
