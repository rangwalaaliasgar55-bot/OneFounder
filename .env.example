# ─── Database ────────────────────────────────────────────────────────────────
# Required. Get from https://neon.tech (free tier available)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# ─── Auth (REQUIRED for sign-in) ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-64-char-random-secret-here

# Backend URL (where Express server runs)
BETTER_AUTH_URL=http://localhost:3001

# Frontend URL (where Vite runs)
CLIENT_URL=http://localhost:5000

# ─── AI — Ollama (Local + Self-hosted) ────────────────────────────────────────
# Point to your Ollama instance
# For mobile AI server (Termux), see termux/README.md
# OLLAMA_BASE_URL=http://<phone-ip>:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-1.5b-instruct

# ─── Social Auth (Optional) ───────────────────────────────────────────────────
# Google OAuth — https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
