# ─── Database ────────────────────────────────────────────────────────────────
# Required. Get from https://neon.tech (free tier available)
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-secret-here-at-least-32-chars

# Required. Your deployed domain (no trailing slash)
# Vercel: https://your-project.vercel.app
# Replit: https://your-repl.replit.dev
BETTER_AUTH_URL=https://your-domain.vercel.app

# Required. Your frontend URL (same as BETTER_AUTH_URL for Vercel)
CLIENT_URL=https://your-domain.vercel.app

# ─── AI — Anthropic Claude (Required for Vercel deployment) ───────────────────
# Get from https://console.anthropic.com
# On Vercel: add this as an environment variable in the Vercel dashboard
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── AI — Ollama (Local development only) ─────────────────────────────────────
# Only needed when running locally with Ollama installed
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── Social Auth (Optional) ───────────────────────────────────────────────────
# Google OAuth — https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
