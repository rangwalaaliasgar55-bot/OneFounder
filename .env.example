# ─── Database ────────────────────────────────────────────────────────────────
# Required. Get from https://neon.tech (free tier available)
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-secret-here-at-least-32-chars

# Required. Your deployed domain (no trailing slash)
BETTER_AUTH_URL=https://your-domain.vercel.app

# Required. Your frontend URL
CLIENT_URL=https://your-domain.vercel.app

# ─── AI — Ollama (Local + Self-hosted) ────────────────────────────────────────
# Point to your Ollama instance
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── Social Auth (Optional) ───────────────────────────────────────────────────
# Google OAuth — https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
