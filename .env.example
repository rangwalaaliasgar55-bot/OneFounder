# ─── Database ────────────────────────────────────────────────────────────────
# Required. Get from https://neon.tech (free tier available)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# ─── Auth (REQUIRED for sign-in) ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-64-char-random-secret-here

# Backend URL (where Express server runs)
BETTER_AUTH_URL=http://localhost:3001

# Frontend URL (where Vite runs)
CLIENT_URL=http://localhost:5000

# ─── AI — Multi-Provider Configuration ────────────────────────────────────────
# OneFounder supports 5 AI providers with automatic fallback.
# Priority order: Termux AI (phone) → Ollama (local) → OpenAI → Anthropic → Gemini
# Only configure the providers you want to use. Unconfigured providers are skipped.

# ─── Termux AI (Phone — OpenAI-compatible local server) ───────────────────────
# Run a local AI server on your Android phone via Termux
# See: https://github.com/termux/termux-app
TERMUX_AI_URL=http://192.168.1.100:8080
TERMUX_AI_KEY=
TERMUX_AI_MODEL=

# ─── Ollama (Local inference — zero cloud cost) ──────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-1.5b-instruct

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ─── Anthropic (Claude) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─── Google Gemini ───────────────────────────────────────────────────────────
GEMINI_API_KEY=...
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash

# ─── Provider Fallback Order ─────────────────────────────────────────────────
# Comma-separated list of provider types to try in order
# Default: termux,ollama,openai,anthropic,gemini
AI_FALLBACK_ORDER=termux,ollama,openai,anthropic,gemini

# ─── Social Auth (Optional) ───────────────────────────────────────────────────
# Google OAuth — https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
